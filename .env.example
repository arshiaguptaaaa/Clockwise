# Copy this file to .env and fill in real values. Never commit .env.
#
# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma7.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

DATABASE_URL="file:./dev.db"

# Required for the Clockwise agent (src/lib/agent/providers/gemini.ts) in
# both Trip Room and My Clockwise. Next.js loads this automatically at
# runtime. Without it, Clockwise replies with an honest "no API key
# configured" message instead of crashing.
GEMINI_API_KEY=""

# Optional. Overrides the Gemini model used by the agent (default:
# gemini-flash-lite-latest — chosen because it has its own separate
# free-tier quota bucket from gemini-flash-latest, which hits a hard
# 20 requests/day cap). Set this to switch models without a code change,
# e.g. once billing is enabled on the Google AI Studio project.
# GEMINI_MODEL="gemini-flash-lite-latest"

# Required for the waitlist email pipeline (src/lib/email/resend-provider.ts).
# Sign up free at resend.com (no card required), copy your API key here.
# Without it, waitlist signups still write to the database — only the
# confirmation/notification emails are skipped, and the server logs an
# honest "RESEND_API_KEY not configured" message rather than faking success.
RESEND_API_KEY=""

# Optional. Once you verify a sending domain in Resend, set this to e.g.
# "Clockwise <hello@clockwise.app>". Until then, emails send from Resend's
# shared onboarding@resend.dev address, which works but has lower
# deliverability and can only send to your own verified Resend account email.
# RESEND_FROM_EMAIL="Clockwise <onboarding@resend.dev>"

# Gates /waitlist-admin and /waitlist-admin/evidence. Set this to your own
# password — it's just a shared login password for this MVP.
ADMIN_PASSWORD=""

# Required for the Uber Sandbox integration (src/lib/uber/*, src/lib/providers/uber-sandbox-provider.ts).
# Register a "Rides API" app at https://developer.uber.com/dashboard, add
# yourself to the app's dev team (Riders API privileged scopes work in
# sandbox immediately for dev-team accounts, no Uber approval needed), then
# paste the Client ID/Secret here. Without these, "Connect Uber" shows an
# honest "not configured" state rather than failing silently.
UBER_CLIENT_ID=""
UBER_CLIENT_SECRET=""
UBER_REDIRECT_URI="http://localhost:3000/api/integrations/uber/callback"

# sandbox | production. Always sandbox until Uber grants Full Access —
# never flip this without deliberately re-checking scopes/approval.
UBER_ENV="sandbox"

# AES-256-GCM key encrypting Uber OAuth tokens at rest in MobilityConnection.
# Generate your own with `openssl rand -hex 32` — losing/rotating this
# invalidates every stored Uber connection (users would need to reconnect).
MOBILITY_TOKEN_ENCRYPTION_KEY=""

# Required for live places/hotels/nearby/routing (src/lib/travel/geoapify-provider.ts).
# Sign up free at https://myprojects.geoapify.com (no card required),
# create a project, copy the API key here. Without it, Clockwise still
# answers questions from trip state, but honestly says live location
# search isn't connected rather than guessing hotels/distances.
GEOAPIFY_API_KEY=""

# Weather (src/lib/travel/open-meteo-weather.ts) needs no key — same
# keyless Open-Meteo family already used for destination geocoding.

# Voice escalation (src/lib/voice-escalation/gnani-provider.ts). Gnani's
# Agent Builder Platform dashboard is at https://app.gnani.ai/agents/login.
# Without these, My Clockwise's "Critical Trip Alerts" escalation runs in
# clearly-labelled DEMO MODE (simulated outcomes only, never a real call).
GNANI_API_KEY=""
GNANI_BOT_ID=""
GNANI_WEBHOOK_SECRET=""
